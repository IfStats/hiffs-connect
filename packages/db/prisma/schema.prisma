generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum MessageChannel {
  SMS
  WHATSAPP
}

enum MessageStatus {
  QUEUED
  ACCEPTED
  SENT
  DELIVERED
  FAILED
}

enum SenderType {
  SHARED
  DEDICATED
}

enum SenderStatus {
  DRAFT
  SUBMITTED
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum PricingStatus {
  ACTIVE
  INACTIVE
}

enum BusinessRole {
  OWNER
  ADMIN
  DEVELOPER
  BILLING
  OPERATOR
  VIEWER
}

enum WalletTransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
}

enum PlatformRole {
  SUPER_ADMIN
  OPERATIONS
  SUPPORT
  FINANCE
  COMPLIANCE
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  RESTRICTED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum ContactStatus {
  ACTIVE
  UNSUBSCRIBED
  BLOCKED
}

enum SmsEncoding {
  GSM7
  UCS2
}

enum SmsUnitTransactionType {
  ADMIN_CREDIT
  ADMIN_DEBIT
  MESSAGE_DEBIT
  REFUND
  ADJUSTMENT
}

enum TemplateStatus {
  ACTIVE
  ARCHIVED
}

enum SenderValidationStatus {
  PENDING
  INTERNAL_REVIEW
  DOCUMENTS_REQUIRED
  READY_FOR_PROVIDER
  PROVIDER_SUBMITTED
  PROVIDER_PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum SenderDocumentStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum SenderAuditAction {
  REGISTRATION_CREATED
  REGISTRATION_SUBMITTED

  VALIDATION_STARTED
  DOCUMENTS_REQUESTED
  REVIEW_RESUMED

  DOCUMENT_UPLOADED
  DOCUMENT_ACCEPTED
  DOCUMENT_REJECTED

  READY_FOR_PROVIDER
  PROVIDER_SUBMITTED
  PROVIDER_PENDING

  APPROVED
  REJECTED
  SUSPENDED
  RESTORED
}

enum WalletTransactionType {
  TOP_UP
  MESSAGE_DEBIT
  SENDER_REGISTRATION_FEE
  REFUND
  ADJUSTMENT
}

model Business {
  id              String @id @default(cuid())
  name            String
  countryCode     String
  billingCurrency String @default("USD") @db.VarChar(3)

  website String?
  email   String?
  phone   String?
  wallet  Wallet?

  senderRequests   SenderRegistration[]
  messages         Message[]
  apiKeys          ApiKey[]
  senderIdentities SenderIdentity[]
  memberships      BusinessMembership[]
  status           AccountStatus        @default(ACTIVE)
  invitations      BusinessInvitation[]
  contacts         Contact[]
  contactGroups    ContactGroup[]
  templates        MessageTemplate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([countryCode])
  @@index([name])
}

model SenderRegistration {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])

  validations        SenderValidation[]
  documents          SenderDocument[]
  walletTransactions WalletTransaction[]

  auditEvents SenderAuditEvent[]

  channel     MessageChannel
  senderType  SenderType
  senderValue String

  countryCode        String
  destinationCountry String?

  provider          String  @default("infobip")
  providerReference String?

  status SenderStatus @default(DRAFT)

  useCase                String?
  estimatedMonthlyVolume Int?
  rejectionReason        String?

  submittedAt DateTime?
  approvedAt  DateTime?
  rejectedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages Message[]

  @@index([businessId])
  @@index([countryCode])
  @@index([status])
  @@index([providerReference])
}

model SenderRequirement {
  id String @id @default(cuid())

  provider    String
  countryCode String

  channel    MessageChannel @default(SMS)
  senderType SenderType

  key         String
  name        String
  description String?

  required Boolean @default(true)

  fieldKey     String?
  documentType String?

  validationRule Json?

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, countryCode, channel, senderType, key])
  @@index([provider])
  @@index([countryCode])
  @@index([channel])
  @@index([senderType])
  @@index([active])
}

model SenderValidation {
  id String @id @default(cuid())

  senderRegistrationId String
  senderRegistration   SenderRegistration @relation(fields: [senderRegistrationId], references: [id], onDelete: Cascade)

  provider    String
  countryCode String

  status SenderValidationStatus @default(PENDING)

  reviewerUserId String?
  reviewerUser   User?   @relation("SenderValidationReviewer", fields: [reviewerUserId], references: [id])

  reviewNotes String?

  providerReference String?

  submittedToProviderAt DateTime?
  completedAt           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([senderRegistrationId])
  @@index([provider])
  @@index([countryCode])
  @@index([status])
  @@index([reviewerUserId])
}

model SenderDocument {
  id String @id @default(cuid())

  senderRegistrationId String
  senderRegistration   SenderRegistration @relation(fields: [senderRegistrationId], references: [id], onDelete: Cascade)

  documentType String

  fileName String
  fileUrl  String

  status SenderDocumentStatus @default(PENDING)

  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([senderRegistrationId])
  @@index([documentType])
  @@index([status])
}

model SenderAuditEvent {
  id String @id @default(cuid())

  senderRegistrationId String
  senderRegistration   SenderRegistration @relation(fields: [senderRegistrationId], references: [id], onDelete: Cascade)

  actorUserId String?
  actorUser   User?   @relation("SenderAuditActor", fields: [actorUserId], references: [id])

  action SenderAuditAction

  fromStatus String?
  toStatus   String?

  documentId   String?
  documentType String?

  provider          String?
  providerReference String?

  note     String?
  metadata Json?

  createdAt DateTime @default(now())

  @@index([senderRegistrationId])
  @@index([actorUserId])
  @@index([action])
  @@index([documentId])
  @@index([createdAt])
}

model CountryPricing {
  id String @id @default(cuid())

  countryCode String
  countryName String
  channel     MessageChannel
  network     String?

  provider String @default("infobip")

  providerCost         Decimal @db.Decimal(12, 6)
  providerCostCurrency String  @default("USD") @db.VarChar(3)

  retailPrice Decimal @db.Decimal(12, 6)
  currency    String  @db.VarChar(3)

  minVolume Int?
  maxVolume Int?

  status        PricingStatus @default(ACTIVE)
  effectiveFrom DateTime      @default(now())
  effectiveTo   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([countryCode])
  @@index([channel])
  @@index([provider])
  @@index([status])
}

model Message {
  id String @id @default(cuid())

  businessId String?
  business   Business? @relation(fields: [businessId], references: [id])

  senderRegistrationId String?
  senderRegistration   SenderRegistration? @relation(fields: [senderRegistrationId], references: [id])

  channel           MessageChannel
  provider          String
  providerMessageId String?

  sender    String?
  recipient String

  countryCode         String?
  destinationCountry  String?
  network             String?
  routingAttempts     MessageRoutingAttempt[]
  walletTransactions  WalletTransaction[]
  smsUnitTransactions SmsUnitTransaction[]
  content             String

  characterCount Int?
  segmentCount   Int?
  smsEncoding    SmsEncoding?

  status MessageStatus @default(QUEUED)

  providerCost         Decimal? @db.Decimal(12, 6)
  providerCostCurrency String?  @db.VarChar(3)

  customerPrice Decimal? @db.Decimal(12, 6)
  currency      String?  @db.VarChar(3)

  providerResponse Json?
  failureReason    String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  sentAt      DateTime?
  deliveredAt DateTime?

  @@index([businessId])
  @@index([senderRegistrationId])
  @@index([recipient])
  @@index([status])
  @@index([providerMessageId])
  @@index([countryCode])
  @@index([createdAt])
}

model WebhookReceipt {
  id String @id @default(cuid())

  provider String
  eventKey String

  providerMessageId String?
  providerStatus    String?

  payload Json

  processedAt     DateTime?
  processingError String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, eventKey])
  @@index([provider])
  @@index([providerMessageId])
  @@index([createdAt])
}

model ProviderRoutingRule {
  id          String         @id @default(cuid())
  countryCode String
  channel     MessageChannel
  provider    String
  network     String?
  priority    Int            @default(100)
  enabled     Boolean        @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([countryCode])
  @@index([channel])
  @@index([provider])
  @@index([priority])
  @@index([enabled])
}

model MessageRoutingAttempt {
  id        String  @id @default(cuid())
  messageId String
  message   Message @relation(fields: [messageId], references: [id])

  routingRuleId String?
  provider      String

  priority      Int?
  attemptNumber Int  @default(1)

  outcome      String
  retryable    Boolean?
  errorCode    String?
  errorMessage String?

  createdAt DateTime @default(now())

  @@index([messageId])
  @@index([provider])
  @@index([routingRuleId])
  @@index([createdAt])
}

model BusinessInvitation {
  id String @id @default(cuid())

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  email String
  role  BusinessRole

  tokenHash String @unique

  status InvitationStatus @default(PENDING)

  invitedByUserId String
  invitedByUser   User   @relation("BusinessInvitationInvitedBy", fields: [invitedByUserId], references: [id])

  acceptedByUserId String?
  acceptedByUser   User?   @relation("BusinessInvitationAcceptedBy", fields: [acceptedByUserId], references: [id])

  expiresAt  DateTime
  acceptedAt DateTime?
  revokedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId])
  @@index([email])
  @@index([status])
  @@index([expiresAt])
  @@index([invitedByUserId])
  @@index([acceptedByUserId])
}

model Wallet {
  id         String   @id @default(cuid())
  businessId String   @unique
  business   Business @relation(fields: [businessId], references: [id])

  currency String  @db.VarChar(3)
  balance  Decimal @default(0) @db.Decimal(18, 6)

  // SMS credit balance
  smsUnits Int @default(0)

  transactions        WalletTransaction[]
  smsUnitTransactions SmsUnitTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WalletTransaction {
  id       String @id @default(cuid())
  walletId String
  wallet   Wallet @relation(fields: [walletId], references: [id])

  messageId String?
  message   Message? @relation(fields: [messageId], references: [id])

  senderRegistrationId String?
  senderRegistration   SenderRegistration? @relation(fields: [senderRegistrationId], references: [id])

  performedByUserId String?
  performedByUser   User?   @relation("WalletTransactionPerformedBy", fields: [performedByUserId], references: [id])

  type   WalletTransactionType
  status WalletTransactionStatus @default(COMPLETED)

  amount   Decimal @db.Decimal(18, 6)
  currency String  @db.VarChar(3)

  balanceBefore Decimal @db.Decimal(18, 6)
  balanceAfter  Decimal @db.Decimal(18, 6)

  reference   String?
  description String?

  createdAt DateTime @default(now())

  @@unique([senderRegistrationId, type])
  @@index([walletId])
  @@index([messageId])
  @@index([performedByUserId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@index([senderRegistrationId])
}

model ApiKey {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])

  name     String
  prefix   String
  keyHash  String @unique
  lastFour String

  enabled    Boolean   @default(true)
  expiresAt  DateTime?
  lastUsedAt DateTime?
  revokedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId])
  @@index([prefix])
  @@index([enabled])
  @@index([expiresAt])
}

model Provider {
  id                  String                       @id @default(cuid())
  code                String                       @unique
  name                String
  enabled             Boolean                      @default(true)
  senderRegistrations ProviderSenderRegistration[]

  supportsSms      Boolean @default(false)
  supportsWhatsApp Boolean @default(false)
  supportsVoice    Boolean @default(false)
  supportsEmail    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled])
}

model SenderIdentity {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id])

  channel     MessageChannel
  senderType  SenderType
  senderValue String
  countryCode String

  status SenderStatus @default(DRAFT)

  useCase                String?
  estimatedMonthlyVolume Int?

  providerRegistrations ProviderSenderRegistration[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, channel, senderValue, countryCode])
  @@index([businessId])
  @@index([countryCode])
  @@index([channel])
  @@index([status])
}

model ProviderSenderRegistration {
  id String @id @default(cuid())

  senderIdentityId String
  senderIdentity   SenderIdentity @relation(fields: [senderIdentityId], references: [id])

  providerId String
  provider   Provider @relation(fields: [providerId], references: [id])

  providerReference String?
  providerSenderId  String?

  status SenderStatus @default(DRAFT)

  submittedAt     DateTime?
  approvedAt      DateTime?
  rejectedAt      DateTime?
  rejectionReason String?

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([senderIdentityId, providerId])
  @@index([senderIdentityId])
  @@index([providerId])
  @@index([status])
  @@index([providerReference])
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  phone         String?   @unique
  phoneVerified DateTime?
  name          String?
  emailVerified DateTime?

  emailVerificationReminderCount  Int       @default(0)
  emailVerificationReminderSentAt DateTime?

  image        String?
  passwordHash String?

  platformRole PlatformRole?

  memberships                 BusinessMembership[]
  walletTransactionsPerformed WalletTransaction[]      @relation("WalletTransactionPerformedBy")
  status                      AccountStatus            @default(ACTIVE)
  invitationsSent             BusinessInvitation[]     @relation("BusinessInvitationInvitedBy")
  invitationsAccepted         BusinessInvitation[]     @relation("BusinessInvitationAcceptedBy")
  senderValidationsReviewed   SenderValidation[]       @relation("SenderValidationReviewer")
  senderAuditEvents           SenderAuditEvent[]       @relation("SenderAuditActor")
  emailVerificationTokens     EmailVerificationToken[]
  phoneVerifications          PhoneVerification[]
  refreshSessions             AuthRefreshSession[]

  smsUnitTransactionsPerformed SmsUnitTransaction[] @relation("SmsUnitTransactionPerformedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([platformRole])
  @@index([emailVerified, createdAt])
}

model AuthRefreshSession {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String @unique

  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model EmailVerificationToken {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String @unique

  expiresAt    DateTime
  usedAt       DateTime?
  attemptCount Int       @default(0)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@index([usedAt])
}

model PhoneVerification {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  phone String

  provider      String @default("infobip")
  providerPinId String

  expiresAt  DateTime
  verifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([phone])
  @@index([providerPinId])
  @@index([expiresAt])
  @@index([verifiedAt])
}

model BusinessMembership {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  role   BusinessRole @default(VIEWER)
  active Boolean      @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, businessId])
  @@index([userId])
  @@index([businessId])
  @@index([role])
  @@index([active])
}

model Contact {
  id String @id @default(cuid())

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  firstName   String?
  lastName    String?
  displayName String?

  phone String
  email String?

  status ContactStatus @default(ACTIVE)

  source   String?
  metadata Json?

  groups ContactGroupMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, phone])
  @@index([businessId])
  @@index([phone])
  @@index([email])
  @@index([status])
  @@index([createdAt])
}

model ContactGroup {
  id String @id @default(cuid())

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name        String
  description String?

  members ContactGroupMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, name])
  @@index([businessId])
  @@index([name])
}

model ContactGroupMember {
  id String @id @default(cuid())

  groupId String
  group   ContactGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([groupId, contactId])
  @@index([groupId])
  @@index([contactId])
}

model MessageTemplate {
  id String @id @default(cuid())

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name String

  channel MessageChannel @default(SMS)

  content String

  variables String[] @default([])

  status TemplateStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, name])
  @@index([businessId])
  @@index([channel])
  @@index([status])
  @@index([createdAt])
}

model SmsUnitTransaction {
  id String @id @default(cuid())

  walletId String
  wallet   Wallet @relation(fields: [walletId], references: [id])

  messageId String?
  message   Message? @relation(fields: [messageId], references: [id])

  performedByUserId String?
  performedByUser   User?   @relation("SmsUnitTransactionPerformedBy", fields: [performedByUserId], references: [id])

  type   SmsUnitTransactionType
  status WalletTransactionStatus @default(COMPLETED)

  units Int

  balanceBefore Int
  balanceAfter  Int

  reference   String?
  description String?

  createdAt DateTime @default(now())

  @@index([walletId])
  @@index([messageId])
  @@index([performedByUserId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
}

model SenderRegistrationPricing {
  id String @id @default(cuid())

  provider    String
  countryCode String

  channel    MessageChannel
  senderType SenderType

  providerCost         Decimal @db.Decimal(12, 6)
  providerCostCurrency String  @db.VarChar(3)

  retailPrice Decimal @db.Decimal(12, 6)
  currency    String  @db.VarChar(3)

  active Boolean @default(true)

  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, countryCode, channel, senderType, currency, effectiveFrom])
  @@index([provider])
  @@index([countryCode])
  @@index([channel])
  @@index([senderType])
  @@index([active])
}
