generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum MessageChannel {
  SMS
  WHATSAPP
}

enum MessageStatus {
  QUEUED
  ACCEPTED
  SENT
  DELIVERED
  FAILED
}

enum SenderType {
  SHARED
  DEDICATED
}

enum SenderStatus {
  DRAFT
  SUBMITTED
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum PricingStatus {
  ACTIVE
  INACTIVE
}

model Business {
  id             String               @id @default(cuid())
  name           String
  countryCode    String
  website        String?
  email          String?
  phone          String?
  wallet         Wallet?

  senderRequests SenderRegistration[]
  messages       Message[]
  apiKeys        ApiKey[]

  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([countryCode])
  @@index([name])
}

model SenderRegistration {
  id                     String         @id @default(cuid())
  businessId             String
  business               Business       @relation(fields: [businessId], references: [id])

  channel                MessageChannel
  senderType             SenderType
  senderValue            String

  countryCode            String
  destinationCountry     String?

  provider               String         @default("infobip")
  providerReference      String?

  status                 SenderStatus   @default(DRAFT)

  useCase                String?
  estimatedMonthlyVolume Int?
  rejectionReason        String?

  submittedAt            DateTime?
  approvedAt             DateTime?
  rejectedAt             DateTime?

  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  messages               Message[]

  @@index([businessId])
  @@index([countryCode])
  @@index([status])
  @@index([providerReference])
}

model CountryPricing {
  id            String         @id @default(cuid())

  countryCode   String
  countryName   String
  channel       MessageChannel
  network       String?

  provider      String         @default("infobip")

  providerCost  Decimal        @db.Decimal(12, 6)
  retailPrice   Decimal        @db.Decimal(12, 6)
  currency      String         @db.VarChar(3)

  minVolume     Int?
  maxVolume     Int?

  status        PricingStatus  @default(ACTIVE)
  effectiveFrom DateTime       @default(now())
  effectiveTo   DateTime?

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([countryCode])
  @@index([channel])
  @@index([provider])
  @@index([status])
}

model Message {
  id                   String               @id @default(cuid())

  businessId           String?
  business             Business?            @relation(fields: [businessId], references: [id])

  senderRegistrationId String?
  senderRegistration   SenderRegistration?  @relation(fields: [senderRegistrationId], references: [id])

  channel              MessageChannel
  provider             String
  providerMessageId    String?

  sender               String?
  recipient            String

  countryCode           String?
  destinationCountry    String?
  network               String?
  routingAttempts       MessageRoutingAttempt[]
  walletTransactions    WalletTransaction[]
  content               String
  status                MessageStatus        @default(QUEUED)

  providerCost          Decimal?             @db.Decimal(12, 6)
  customerPrice         Decimal?             @db.Decimal(12, 6)
  currency              String?              @db.VarChar(3)

  providerResponse      Json?
  failureReason         String?

  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  sentAt                DateTime?
  deliveredAt           DateTime?

  @@index([businessId])
  @@index([senderRegistrationId])
  @@index([recipient])
  @@index([status])
  @@index([providerMessageId])
  @@index([countryCode])
  @@index([createdAt])
}

model ProviderRoutingRule {
  id          String         @id @default(cuid())
  countryCode String
  channel     MessageChannel
  provider    String
  network     String?
  priority    Int            @default(100)
  enabled     Boolean        @default(true)

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([countryCode])
  @@index([channel])
  @@index([provider])
  @@index([priority])
  @@index([enabled])
}

model MessageRoutingAttempt {
  id            String   @id @default(cuid())
  messageId     String
  message       Message  @relation(fields: [messageId], references: [id])

  routingRuleId String?
  provider      String

  priority      Int?
  attemptNumber Int      @default(1)

  outcome       String
  retryable     Boolean?
  errorCode     String?
  errorMessage  String?

  createdAt     DateTime @default(now())

  @@index([messageId])
  @@index([provider])
  @@index([routingRuleId])
  @@index([createdAt])
}

enum WalletTransactionType {
  TOP_UP
  MESSAGE_DEBIT
  REFUND
  ADJUSTMENT
}

enum WalletTransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
}

model Wallet {
  id         String              @id @default(cuid())
  businessId String              @unique
  business   Business            @relation(fields: [businessId], references: [id])

  currency   String              @db.VarChar(3)
  balance    Decimal             @default(0) @db.Decimal(18, 6)

  transactions WalletTransaction[]

  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
}

model WalletTransaction {
  id            String                  @id @default(cuid())
  walletId      String
  wallet        Wallet                  @relation(fields: [walletId], references: [id])

  messageId     String?
  message       Message?                @relation(fields: [messageId], references: [id])

  type          WalletTransactionType
  status        WalletTransactionStatus @default(COMPLETED)

  amount        Decimal                 @db.Decimal(18, 6)
  currency      String                  @db.VarChar(3)

  balanceBefore Decimal                 @db.Decimal(18, 6)
  balanceAfter  Decimal                 @db.Decimal(18, 6)

  reference     String?
  description   String?

  createdAt     DateTime                @default(now())

  @@index([walletId])
  @@index([messageId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
}

model ApiKey {
  id         String    @id @default(cuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id])

  name       String
  prefix     String
  keyHash    String    @unique
  lastFour   String

  enabled    Boolean   @default(true)
  expiresAt  DateTime?
  lastUsedAt DateTime?
  revokedAt  DateTime?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([businessId])
  @@index([prefix])
  @@index([enabled])
  @@index([expiresAt])
}